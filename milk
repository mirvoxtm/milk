#!/bin/sh
# milk launcher: runs the current build from the clone (the Linux analogue of
# "Iniciar Temenos.vbs" in the Windows version). When bin/milk is missing or
# older than the sources, the session (`start`, the default command, which a
# restart in place runs again) waits for the rebuild so it runs what the sources
# say; if the rebuild fails, the previous binary keeps the session going. Any
# other command (settings, launcher, lock...) runs the previous binary at once
# and rebuilds in the background (a build takes about a minute), one at a time,
# logged to ~/.cache/milk/milk-build.log. Runtime data lives in
# <Documents>/milk/runtime (override with --runtime-root or $MILK_RUNTIME), the
# settings in ~/.config/milk/milk.json (created from milk.default.json; override
# with --config or $MILK_CONFIG).
dir=$(dirname "$(readlink -f "$0")")
bin="$dir/bin/milk"
newest_source=$(find "$dir/src" "$dir/milk.default.json" \( -name '*.odin' -o -name milk.default.json \) -newer "$bin" 2>/dev/null | head -n 1)
if [ ! -x "$bin" ]; then
    "$dir/build.sh" >&2 || { echo "milk: build failed and no previous binary exists" >&2; exit 1; }
elif [ -n "$newest_source" ]; then
    case "${1:-start}" in
    start|-*)
        "$dir/build.sh" >&2 || echo "milk: build failed; starting the previous binary" >&2
        ;;
    update) ;; # pulls and rebuilds everything itself
    *)
        log="${XDG_CACHE_HOME:-$HOME/.cache}/milk/milk-build.log"
        mkdir -p "${log%/*}"
        ( (
            if command -v flock >/dev/null 2>&1; then flock -n 9 || exit 0; fi
            exec "$dir/build.sh" >"$log" 2>&1 </dev/null
        ) 9>"$log.lock" & )
        ;;
    esac
fi
exec "$bin" "$@"
