#!/bin/sh
# milk launcher: runs the current build from the clone (the Linux analogue of
# "Iniciar Temenos.vbs" in the Windows version). Rebuilds bin/milk with the Odin
# compiler when it is missing or older than the sources; if a rebuild fails, the
# previous binary keeps running so the session still starts. Runtime data lives
# in <Documents>/milk/runtime (override with --runtime-root or $MILK_RUNTIME), the
# settings in ~/.config/milk/milk.json (created from milk.default.json; override
# with --config or $MILK_CONFIG).
dir=$(dirname "$(readlink -f "$0")")
bin="$dir/bin/milk"
newest_source=$(find "$dir/src" "$dir/milk.default.json" \( -name '*.odin' -o -name milk.default.json \) -newer "$bin" 2>/dev/null | head -n 1)
if [ ! -x "$bin" ] || [ -n "$newest_source" ]; then
    if ! "$dir/build.sh" >&2; then
        if [ -x "$bin" ]; then
            echo "milk: build failed; starting the previous binary" >&2
        else
            echo "milk: build failed and no previous binary exists" >&2
            exit 1
        fi
    fi
fi
exec "$bin" "$@"
