#!/bin/sh
# milk X session, started by the display manager (SDDM, LightDM, GDM) through
# its Xsession wrapper with DISPLAY and XAUTHORITY already set. milk acts as the
# window manager here, so the session lasts as long as it runs (Mod+Shift+q logs out).
# Its output lands in the display manager's session log (~/.local/share/sddm/xorg-session.log).
dir=$(dirname "$(dirname "$(readlink -f "$0")")")

# Remember where milk lives, so /usr/local/bin/milk-session finds it quickly.
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/milk"
printf '%s\n' "$dir" > "${XDG_CONFIG_HOME:-$HOME/.config}/milk/location"

[ -f "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources"

# The installer puts odin (when the distribution has no recent one), matugen
# and the milk commands in ~/.local/bin; not every login shell adds it.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Programs started through D-Bus or systemd (portals, flameshot) take their
# environment from the user manager, which outlives sessions and may still
# describe an earlier Wayland one; point it at this X session.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-milk}"
unset WAYLAND_DISPLAY

# Qt apps take milk's colours (appearance.themeApps) through qt5ct / qt6ct,
# unless the session already chose a platform theme. "qt5ct" serves both Qt 5
# (qt5ct) and Qt 6 (qt6ct answers to that name too); with qt6ct alone, "qt6ct".
if [ -z "$QT_QPA_PLATFORMTHEME" ]; then
    if command -v qt5ct >/dev/null 2>&1; then
        export QT_QPA_PLATFORMTHEME=qt5ct
    elif command -v qt6ct >/dev/null 2>&1; then
        export QT_QPA_PLATFORMTHEME=qt6ct
    fi
fi

command -v systemctl >/dev/null 2>&1 && systemctl --user unset-environment WAYLAND_DISPLAY 2>/dev/null
command -v dbus-update-activation-environment >/dev/null 2>&1 &&
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP \
        XDG_SESSION_TYPE XDG_SESSION_DESKTOP DESKTOP_SESSION ${QT_QPA_PLATFORMTHEME:+QT_QPA_PLATFORMTHEME} 2>/dev/null

exec "$dir/milk" start --foreground
