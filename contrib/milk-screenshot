#!/bin/sh
# Region screenshot for milk (Super+Shift+S).
# Uses the first tool available: flameshot (its own editor), maim, scrot, or
# ImageMagick's `import` (drag a rectangle; a plain click takes that window).
# Saved to <Pictures>/Screenshots and copied to the clipboard (flameshot copies
# by itself; the other tools need xclip).
pictures=$(xdg-user-dir PICTURES 2>/dev/null)
[ -n "$pictures" ] || pictures="$HOME/Pictures"
dir="$pictures/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

if command -v flameshot >/dev/null 2>&1; then
    # Flameshot 14 captures through xdg-desktop-portal, which has no screenshot
    # backend on a plain X session like milk's ("Unable to capture screen");
    # its X11 capture needs useX11LegacyScreenshot. Set once, unless the user
    # chose a value; older versions, which lack the key, are left alone.
    ini="${XDG_CONFIG_HOME:-$HOME/.config}/flameshot/flameshot.ini"
    if ! grep -q '^useX11LegacyScreenshot=' "$ini" 2>/dev/null &&
        grep -qa useX11LegacyScreenshot "$(command -v flameshot)" 2>/dev/null; then
        mkdir -p "$(dirname "$ini")"
        if grep -q '^\[General\]' "$ini" 2>/dev/null; then
            sed -i '/^\[General\]/a useX11LegacyScreenshot=true' "$ini"
        else
            [ -s "$ini" ] && printf '\n' >> "$ini"
            printf '[General]\nuseX11LegacyScreenshot=true\n' >> "$ini"
        fi
    fi
    # --path alone makes Enter / double-click only save the file; --clipboard
    # copies it as well, so it can be pasted right away.
    exec flameshot gui --path "$dir" --clipboard
elif command -v maim >/dev/null 2>&1; then
    maim -s -u "$file" || exit 0
elif command -v scrot >/dev/null 2>&1; then
    scrot -s -f "$file" || exit 0
elif command -v import >/dev/null 2>&1; then
    import "$file" || exit 0
else
    notify-send "milk" "Install flameshot, maim or scrot to take screenshots" 2>/dev/null
    exit 1
fi

[ -s "$file" ] || exit 0
if command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -t image/png -i "$file"
fi
notify-send -i "$file" "Screenshot" "$file" 2>/dev/null || true
